<section class="resume-section" id="resume">
  <div class="resume-toolbar">
    <h2 class="resume-heading">Resume</h2>
    <button class="resume-print-btn" type="button" aria-label="Print resume">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="6 9 6 2 18 2 18 9"></polyline>
        <path d="M6 12H4a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2h-2"></path>
        <rect x="6" y="14" width="12" height="8"></rect>
      </svg>
      Print / PDF
    </button>
  </div>

  <div class="resume-sheet">
    <!-- Header -->
    <header class="r-header">
      <div class="r-header__name">
        <h1>WICKII Zhang</h1>
        <p class="r-header__role">Staff Embedded Software Engineer &middot; AI-Native</p>
      </div>
      <div class="r-header__contact">
        <span>(+86) 189-****-****</span>
        <span>WICKZHAN@QTI.QUALCOMM.COM</span>
        <span>Shanghai, China</span>
      </div>
    </header>

    <!-- Metrics bar -->
    <div class="r-metrics">
      <div class="r-metric">HammerAgent owner</div>
      <div class="r-metric">#1 Modem App Hub</div>
      <div class="r-metric">10K+ parser usage</div>
      <div class="r-metric">5G RF software</div>
      <div class="r-metric">AI triage</div>
    </div>

    <!-- Two-column body -->
    <div class="r-grid">
      <!-- Left sidebar -->
      <aside class="r-panel">
        <section class="r-block">
          <h2>Technical Skills</h2>

          <div class="r-skill-group r-skill-group--green">
            <h3>AI / Agent Engineering</h3>
            <div class="r-chips">
              <span class="r-chip">QGenie SDK</span><span class="r-chip">LLM/NLP</span><span class="r-chip">RAG</span><span class="r-chip">Embeddings</span><span class="r-chip">MCP</span><span class="r-chip">A2A</span><span class="r-chip">Evidence extraction</span><span class="r-chip">HITL validation</span><span class="r-chip">FastAPI</span><span class="r-chip">Pipeline runner</span><span class="r-chip">Serial queue</span><span class="r-chip">Crash recovery</span><span class="r-chip">SQLite</span><span class="r-chip">Threshold engine</span><span class="r-chip">Telemetry</span><span class="r-chip">Learning loop</span>
            </div>
          </div>

          <div class="r-skill-group r-skill-group--blue">
            <h3>Wireless / RF Front-End</h3>
            <div class="r-chips">
              <span class="r-chip">5G NR RF SW</span><span class="r-chip">TxAGC</span><span class="r-chip">DSDA/DSDS Tx</span><span class="r-chip">SUL</span><span class="r-chip">ULCA</span><span class="r-chip">SRS switching</span><span class="r-chip">PA/PAPM/XSW/ASM</span><span class="r-chip">RFFE timing</span>
            </div>
          </div>

          <div class="r-skill-group r-skill-group--blue">
            <h3>Modem / Tools</h3>
            <div class="r-chips">
              <span class="r-chip">Python</span><span class="r-chip">C</span><span class="r-chip">Git</span><span class="r-chip">Hexagon</span><span class="r-chip">ARM IU</span><span class="r-chip">MATLAB</span><span class="r-chip">Qualcomm Modem Suite</span>
            </div>
          </div>

          <div class="r-skill-group r-skill-group--amber">
            <h3>RF Hardware</h3>
            <div class="r-chips">
              <span class="r-chip">PA</span><span class="r-chip">ADS</span><span class="r-chip">Altium</span><span class="r-chip">Callbox</span><span class="r-chip">VNA</span><span class="r-chip">Spectrum analyzer</span><span class="r-chip">Signal source</span>
            </div>
          </div>
        </section>

        <section class="r-block">
          <h2>Education</h2>
          <div class="r-edu-card">
            <h3>M.E., Electronic Science and Technology</h3>
            <p>Beijing University of Posts and Telecommunications &middot; Jun 2019</p>
            <strong>Rank: 20 / 275</strong>
          </div>
          <div class="r-edu-card">
            <h3>B.S., Communication Engineering</h3>
            <p>Liaoning Technical University &middot; Jun 2016</p>
            <strong>Rank: 5 / 120 &middot; CET-6: 539 / 710 &middot; NCRE Grade 2</strong>
          </div>
        </section>

        <section class="r-block">
          <h2>Academic Projects</h2>
          <ul>
            <li>863 Program: Designed high-efficiency GaN Doherty power amplifiers covering LTE bands in China, targeting 52 dBm peak output power and over 40% drain efficiency at 6 dB output power back-off.</li>
            <li>973 Program: Explored efficiency improvement methodology for base stations and implemented a novel power amplifier with efficiency above 55% at 8–12 dB OBO under a 150 MHz modulated signal.</li>
          </ul>
        </section>

        <section class="r-block">
          <h2>Awards</h2>
          <ul>
            <li>2nd National Prize, China Post-Graduate Mathematical Contest in Modeling.</li>
            <li>1st Prize Academic Scholarship of BUPT, three times.</li>
            <li>2nd National Prize, China Undergraduate Mathematical Contest in Modeling.</li>
            <li>National Scholarship of LNTU; 1st Prize Academic Scholarship of LNTU, four times.</li>
            <li>1st Provincial Prize, Chinese Mathematics Competitions.</li>
          </ul>
        </section>

        <section class="r-block">
          <h2>Languages</h2>
          <ul>
            <li><strong>English</strong> — Professional working proficiency (CET-6: 539/710)</li>
            <li><strong>Mandarin Chinese</strong> — Native</li>
          </ul>
        </section>
      </aside>

      <!-- Right main -->
      <div class="r-main">
        <section class="r-block">
          <h2>Professional Summary</h2>
          <ul>
            <li>Owner of HammerAgent, an AI-assisted modem debugging system built on QGenie SDK/model integration, agentic tool workflows, domain-specific RAG, evidence score, and rule-driven log analysis for RF, Digital, and MAC UL debug.</li>
            <li>Architected Hammer/HammerAgent as an E2E triage platform with FastAPI web portal/orchestrator, local pipeline runner, parser/analysis engine, cross-layer correlation, deterministic verdict gate, advisory AI layer, feedback store, and continuous learning loop.</li>
            <li>Staff RF Embedded Software Engineer with deep experience in 5G modem RF software, Tx architecture, RFFE control, product bring-up, customer escalation, and Hexagon &amp; ARM IU processor development.</li>
          </ul>
        </section>

        <section class="r-block">
          <h2>Work Experience</h2>

          <article class="r-timeline-item">
            <div class="r-timeline-head">
              <h3>Qualcomm — Staff RF Software Engineer</h3>
              <span>Dec 2024 – Present &middot; Pudong, Shanghai</span>
            </div>
            <ul>
              <li>Created HammerAgent, an end-to-end AI-assisted debugging agent for RF, Digital, and MAC UL analysis, integrating QGenie SDK/model access, in-house embeddings, skill/tool orchestration, evidence extraction, and human-in-the-loop diagnosis.</li>
              <li>Co-architected Autologparser from parser automation into a measurable closed-loop triage architecture with QUTS/QXDM parsing, opcode registry, QTRACE/IQ capture, SQLite artifacts, FastAPI orchestration, dashboard telemetry, feedback ratings, and email/report delivery.</li>
              <li>Drove early-stage design and technical proposals with RF System and Modem System teams for TxAGC evolution, uplink power limiting, envelope expansion, and UL enhancement from concept to bring-up readiness.</li>
              <li>Designed and debugged RFFE control behavior across PA, PAPM, XSW, ASM, and tuner paths; served as point of contact for DSDA Tx and Intra-CA Tx feature design, triage, and customer support.</li>
            </ul>
          </article>

          <article class="r-timeline-item">
            <div class="r-timeline-head">
              <h3>Qualcomm — Senior Software Engineer</h3>
              <span>May 2019 – Nov 2024 &middot; Pudong, Shanghai</span>
            </div>
            <ul>
              <li>Developed and brought up 5G modem RF software in highly concurrent embedded environments, covering RF/BB integration, Tx behavior, RFFE control, modem timing, certification, performance, stability, and customer issue resolution.</li>
              <li>Supported onsite and remote factory bring-up for Apple 5G products, including modem integration, RF calibration, production issue debugging, and cross-layer troubleshooting across RF software, modem control, and system behavior.</li>
              <li>Collaborated with System, RF, BB, AS, CE, and global development teams under aggressive schedules; mentored team members on RF debugging methodology, trace interpretation, and feature bring-up flow.</li>
            </ul>
          </article>

          <article class="r-timeline-item">
            <div class="r-timeline-head">
              <h3>Apple R&amp;D (Beijing) Limited — Wireless Design Innovator Intern</h3>
              <span>Jun 2018 – Apr 2019</span>
            </div>
            <ul>
              <li>Built MMW RADAR applications with AWR1642 development kits.</li>
              <li>Explored intelligent issue triage powered by NLP log analysis.</li>
              <li>Participated in wireless product innovation activities with project managers, innovators, design engineers, manufacturing teams, and third-party testing labs.</li>
            </ul>
          </article>

          <article class="r-timeline-item">
            <div class="r-timeline-head">
              <h3>Ericsson — Product Integration Intern</h3>
              <span>Jun 2018 – Jul 2018</span>
            </div>
            <ul>
              <li>Responsible for RRU HW integration of Ericsson radio products, troubleshooting complex problems from product development, manufacturing, and field customer escalation.</li>
              <li>Core contributor to product quality assurance for radio hardware throughout the product lifecycle.</li>
            </ul>
          </article>

          <article class="r-timeline-item">
            <div class="r-timeline-head">
              <h3>Keysight Technologies — Application Engineer Intern</h3>
              <span>Sep 2017 – May 2018</span>
            </div>
            <ul>
              <li>Delivered solutions and guided customers on Keysight test equipment and services at the system/solutions level.</li>
              <li>Integrated Keysight products into customer environments, bridging test &amp; measurement with real-world deployment scenarios.</li>
            </ul>
          </article>
        </section>

        <section class="r-block">
          <h2>Publications &amp; Patents</h2>
          <div class="r-pub-card">
            <ul>
              <li><a href="https://ieeexplore.ieee.org/abstract/document/8400934" target="_blank" rel="noreferrer">C. Yu, W. Zhang and Y. Liu, "A broadband Doherty power amplifier based on rotated T-shape load modulation network," 2018 IEEE MTT-S International Wireless Symposium, Chengdu, China, 2018.</a></li>
              <li>2505340WO1 — Power allocation handling for uplink component carriers in an uplink carrier aggregation configuration.</li>
              <li><a href="https://patents.google.com/patent/WO2022222023" target="_blank" rel="noreferrer">WO2022222023 — UE capability information for frequency band combination conflict.</a></li>
              <li><a href="https://patents.google.com/patent/WO2022252169A1" target="_blank" rel="noreferrer">WO2022252169A1 — Dynamic code block group allocation.</a></li>
            </ul>
          </div>
        </section>
      </div>
    </div>
  </div>
</section>

<script>
  // Print button handler
  document.querySelector('.resume-print-btn')?.addEventListener('click', () => {
    window.print();
  });
</script>

<style>
  /* =====================================================
     On-screen resume styles — scoped by Astro
     ===================================================== */

  .resume-section {
    margin-top: 2rem;
  }

  .resume-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .resume-heading {
    margin: 0;
    font-size: 1.4rem;
    color: var(--accent-strong);
    letter-spacing: 0.04em;
  }

  .resume-print-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: transparent;
    color: var(--accent-strong);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .resume-print-btn:hover {
    background: var(--accent);
    color: #fff;
  }

  .resume-print-btn svg {
    flex-shrink: 0;
  }

  /* ---- Sheet (card) ---- */
  .resume-sheet {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 2.2rem 1.6rem;
    background: var(--surface-strong, #fffdf8);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    position: relative;
    overflow: hidden;
  }

  /* Gold/teal accent stripe */
  .resume-sheet::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: linear-gradient(90deg, var(--accent), #b8942e);
  }

  /* ---- Header ---- */
  .r-header {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    padding-top: 0.4rem;
    padding-bottom: 0.75rem;
    border-bottom: 1.5px solid #d4af37;
    margin-bottom: 0.6rem;
    align-items: end;
  }

  .r-header__name h1 {
    margin: 0;
    font-size: 1.65rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #0f172a;
    line-height: 0.95;
  }

  .r-header__role {
    margin: 0.3rem 0 0;
    font-size: 0.72rem;
    font-weight: 850;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .r-header__contact {
    text-align: right;
    font-size: 0.68rem;
    color: #334155;
    line-height: 1.35;
    white-space: nowrap;
  }

  .r-header__contact span {
    display: block;
  }

  /* ---- Metrics ---- */
  .r-metrics {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.3rem;
    margin: 0.5rem 0 0.7rem;
  }

  .r-metric {
    border: 1px solid #d9caa4;
    border-radius: 7px;
    padding: 0.3rem 0.2rem;
    text-align: center;
    font-size: 0.6rem;
    font-weight: 850;
    color: #1f2937;
    background: linear-gradient(180deg, #fff7dc, #fffdf8);
  }

  .r-metric:nth-child(2) {
    border-color: #99f6e4;
    background: linear-gradient(180deg, #ecfdf5, #fffdf8);
  }

  .r-metric:nth-child(3) {
    border-color: #bfdbfe;
    background: linear-gradient(180deg, #eff6ff, #fffdf8);
  }

  .r-metric:nth-child(4) {
    border-color: #fed7aa;
    background: linear-gradient(180deg, #fff7ed, #fffdf8);
  }

  .r-metric:nth-child(5) {
    border-color: #ddd6fe;
    background: linear-gradient(180deg, #f5f3ff, #fffdf8);
  }

  /* ---- Two-column grid ---- */
  .r-grid {
    display: grid;
    grid-template-columns: 1fr 1.75fr;
    gap: 0.9rem;
    align-items: start;
  }

  /* ---- Left panel ---- */
  .r-panel {
    border: 1.2px solid #bfd8d4;
    border-radius: 8px;
    padding: 0.55rem;
    background: linear-gradient(180deg, #f0fdfa, #fffdf8);
    box-shadow: inset 3px 0 0 var(--accent);
  }

  /* ---- Blocks ---- */
  .r-block {
    margin-bottom: 0.55rem;
  }

  .r-block:last-child {
    margin-bottom: 0;
  }

  .r-block h2 {
    margin: 0 0 0.4rem;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #0f172a;
  }

  .r-block h2::after {
    content: "";
    display: block;
    width: 24px;
    height: 1.2px;
    margin-top: 0.25rem;
    background: linear-gradient(90deg, var(--accent), #d4af37);
  }

  .r-block h3 {
    margin: 0;
    font-size: 0.78rem;
    color: #1e293b;
    line-height: 1.2;
  }

  .r-block p {
    margin: 0.15rem 0 0;
    font-size: 0.7rem;
    color: #525252;
  }

  .r-block ul {
    margin: 0.15rem 0 0;
    padding-left: 1rem;
    font-size: 0.7rem;
  }

  .r-block li {
    margin-bottom: 0.15rem;
    padding-left: 0.1rem;
    color: #374151;
  }

  .r-block li::marker {
    color: #b8942e;
  }

  /* ---- Skill groups ---- */
  .r-skill-group {
    margin-bottom: 0.4rem;
  }

  .r-skill-group:last-child {
    margin-bottom: 0;
  }

  .r-skill-group h3 {
    color: var(--accent);
    font-size: 0.68rem;
    margin-bottom: 0.2rem;
    font-weight: 700;
  }

  .r-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.22rem;
  }

  /* ── Base chip (fallback, no group modifier) ── */
  .r-chip {
    display: inline-block;
    border-radius: 999px;
    padding: 0.12rem 0.45rem;
    font-size: 0.6rem;
    font-weight: 700;
    border: 1px solid #c5cfc6;
    background: #eef1ee;
    color: #3d4d3e;
  }

  /* ── 莫兰蒂绿 — AI / LLM (苔藓绿 sage) ── */
  .r-skill-group--green .r-chip {
    border: 1px solid #9fb8a0;
    background: linear-gradient(135deg, #e8f0e9, #f3f7f3);
    color: #2d4a31;
  }

  .r-skill-group--green h3 {
    color: #4a7c52;
  }

  /* ── 莫兰蒂蓝 — Modem / Tx (雾霾蓝 dusty slate) ── */
  .r-skill-group--blue .r-chip {
    border: 1px solid #8da8c0;
    background: linear-gradient(135deg, #e4ecf4, #f1f5f9);
    color: #243d56;
  }

  .r-skill-group--blue h3 {
    color: #3a6285;
  }

  /* ── 莫兰蒂黄 — RF Hardware / EDA (小麦金 warm wheat) ── */
  .r-skill-group--amber .r-chip {
    border: 1px solid #c8aa74;
    background: linear-gradient(135deg, #f5ecda, #faf6ee);
    color: #5a3e1b;
  }

  .r-skill-group--amber h3 {
    color: #8a6020;
  }

  /* ---- Education cards ---- */
  .r-edu-card {
    border-left: 2px solid #d4af37;
    padding-left: 0.55rem;
    margin-bottom: 0.35rem;
    background: #fffaf0;
    padding-top: 0.2rem;
    padding-bottom: 0.2rem;
  }

  .r-edu-card:last-child {
    margin-bottom: 0;
  }

  .r-edu-card h3 {
    font-size: 0.78rem;
  }

  .r-edu-card strong {
    display: block;
    margin-top: 0.1rem;
    font-size: 0.65rem;
    color: #4b3f2b;
  }

  /* ---- Timeline items ---- */
  .r-timeline-item {
    margin-bottom: 0.5rem;
    padding: 0.45rem 0.55rem 0.35rem;
    border: 1px solid #dbeafe;
    border-left: 3px solid #2563eb;
    border-radius: 7px;
    background: linear-gradient(180deg, #f8fbff, #fffdf8);
  }

  .r-timeline-item:nth-child(2) {
    border-color: #ccfbf1;
    border-left-color: var(--accent);
    background: linear-gradient(180deg, #f0fdfa, #fffdf8);
  }

  .r-timeline-item:nth-child(3) {
    border-color: #fde68a;
    border-left-color: #d4af37;
    background: linear-gradient(180deg, #fffbeb, #fffdf8);
  }

  .r-timeline-head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
  }

  .r-timeline-head h3 {
    font-size: 0.78rem;
  }

  .r-timeline-head span {
    font-size: 0.65rem;
    font-weight: 800;
    color: #6f6250;
    white-space: nowrap;
    text-align: right;
  }

  .r-timeline-item ul {
    font-size: 0.68rem;
  }

  /* ---- Publications card ---- */
  .r-pub-card {
    border: 1px solid #e5ddd1;
    border-radius: 7px;
    padding: 0.4rem 0.55rem;
    background: linear-gradient(180deg, #fffaf0, #fffdf8);
  }

  .r-pub-card a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: #c8aa74;
    text-underline-offset: 2px;
    transition: color 0.15s ease;
  }

  .r-pub-card a:hover {
    color: var(--accent-strong);
    text-decoration-color: var(--accent);
  }

  /* =====================================================
     Print / PDF — scoped here so Astro's specificity
     matches and screen styles don't override print.
     ===================================================== */
  @media print {
    .resume-section {
      margin-top: 0;
    }

    .resume-toolbar {
      display: none;
    }

    /* A4 sheet — generous padding to breathe */
    .resume-sheet {
      width: 210mm;
      min-height: 297mm;
      max-width: none;
      margin: 0;
      padding: 1.6rem 1.8rem 1.4rem;
      background: var(--surface-strong, #fffdf8);
      border: none;
      border-radius: 0;
      box-shadow: none;
      overflow: visible;
    }

    /* Gold/teal accent stripe preserved */
    .resume-sheet::before {
      height: 3mm;
      background: linear-gradient(90deg, var(--accent), #b8942e);
    }

    .r-header {
      padding-top: 0.2rem;
      padding-bottom: 0.75rem;
      margin-bottom: 0.55rem;
      gap: 0.75rem;
    }

    .r-header__name h1 {
      font-size: 1.65rem;
      letter-spacing: 0.06em;
    }

    .r-header__role {
      font-size: 0.72rem;
      margin-top: 0.3rem;
    }

    .r-header__contact {
      font-size: 0.68rem;
      line-height: 1.5;
    }

    .r-metrics {
      margin: 0.5rem 0 0.65rem;
      gap: 0.3rem;
    }

    .r-metric {
      font-size: 0.62rem;
      padding: 0.35rem 0.25rem;
    }

    /* Two-column grid preserved in print */
    .r-grid {
      display: grid;
      grid-template-columns: 1fr 1.75fr;
      gap: 0.9rem;
    }

    .r-panel {
      padding: 0.65rem;
    }

    .r-block {
      margin-bottom: 0.65rem;
    }

    .r-block h2 {
      font-size: 0.78rem;
      margin-bottom: 0.45rem;
    }

    .r-block h2::after {
      width: 24px;
      margin-top: 0.25rem;
    }

    .r-block h3 {
      font-size: 0.78rem;
    }

    .r-block p {
      font-size: 0.7rem;
      margin-top: 0.15rem;
      line-height: 1.5;
    }

    .r-block ul {
      font-size: 0.7rem;
      margin-top: 0.15rem;
    }

    .r-block li {
      margin-bottom: 0.2rem;
      line-height: 1.5;
    }

    .r-block strong {
      font-size: 0.68rem;
    }

    .r-skill-group {
      margin-bottom: 0.5rem;
    }

    .r-skill-group h3 {
      font-size: 0.68rem;
      margin-bottom: 0.22rem;
    }

    .r-chips {
      gap: 0.22rem;
    }

    .r-chip {
      font-size: 0.6rem;
