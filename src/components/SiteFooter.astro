---
import { siteConfig } from "../site.config";
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div>
      <p class="site-footer__title">{siteConfig.title}</p>
      <p>{siteConfig.footerTagline}</p>
    </div>

    <ul class="social-links" role="list">
      {siteConfig.social.map((item) => (
        <li><a href={item.href} target="_blank" rel="noreferrer">{item.label}</a></li>
      ))}
    </ul>
  </div>
</footer>

<script>
  const navToggle = document.querySelector("[data-nav-toggle]");
  const navPanel = document.querySelector("[data-nav-panel]");

  if (navToggle instanceof HTMLButtonElement && navPanel instanceof HTMLElement) {
    navToggle.addEventListener("click", () => {
      const expanded = navToggle.getAttribute("aria-expanded") === "true";
      navToggle.setAttribute("aria-expanded", String(!expanded));
      navPanel.classList.toggle("is-open");
    });
  }
</script>
